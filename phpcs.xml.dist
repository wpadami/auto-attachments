<?xml version="1.0"?>
<ruleset name="Auto Attachments">
	<description>WPCS ruleset for the Auto Attachments plugin.</description>

	<!--
	Scoped to src/ (the OOP code under the architecture mandate in
	claude.md) plus auto-attachments.php, now that it's just a thin
	autoload/bootstrap file - all of its former logic moved into src/ in
	v0.14.0. There's no more legacy procedural code left to expand this
	into; admin/metaboxes.php and admin/shortcodes.php were removed the
	same release.
	-->
	<file>src</file>
	<file>auto-attachments.php</file>

	<arg name="basepath" value="." />
	<arg name="colors" />
	<arg name="extensions" value="php" />
	<arg value="sp" />

	<rule ref="WordPress-Extra">
		<exclude name="WordPress.Files.FileName" />
	</rule>
	<rule ref="WordPress-Docs" />

	<config name="minimum_supported_wp_version" value="5.0" />

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="auto-attachments" />
				<element value="autoa" />
			</property>
		</properties>
	</rule>

	<rule ref="PHPCompatibilityWP" />
	<config name="testVersion" value="7.4-" />
</ruleset>
